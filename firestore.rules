rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // AUTHENTICATION HELPER
    // ==================================================

    function isSignedIn() {
      return request.auth != null;
    }


    // ==================================================
    // USERS
    // ==================================================

    match /users/{userId} {

      allow read, write:
        if isSignedIn()
        && request.auth.uid == userId;
    }


    // ==================================================
    // BRAND PROFILES
    // ==================================================

    match /brandProfiles/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // BRAND
    // ==================================================

    match /brand/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // CONTENT
    // ==================================================

    match /content/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // CALENDAR
    // ==================================================

    match /calendar/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // CALENDAR POSTS
    // ==================================================
    //
    // Digunakan oleh Calendar.jsx dan scheduling.
    //
    // ==================================================

    match /calendarPosts/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // AUTOPILOT
    // ==================================================

    match /autopilot/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // THREADS
    // ==================================================

    match /threads/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // ANALYTICS
    // ==================================================

    match /analytics/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // SETTINGS
    // ==================================================

    match /settings/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // TRENDS
    // ==================================================

    match /trends/{documentId} {

      allow read, write:
        if isSignedIn();
    }


    // ==================================================
    // DEFAULT DENY
    // ==================================================

    match /{document=**} {

      allow read, write: if false;
    }
  }
}